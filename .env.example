# Copy this file to .env.local and adjust values for your machine.
# Priority: command args > .env.local > .env > script defaults.

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8082
AUTH_TOKEN=
RATE_LIMIT_SESSIONS_PER_SEC=30
FRONTEND_DIR=../frontend/src
SESSION_META_MAP_FILE=.run/session-meta-map.json

# Adapters
ENABLED_ADAPTERS=codex
DEFAULT_ADAPTER=codex

# Codex adapter
CODEX_CLI_BIN=codex
# Values are sourced by bash; keep quotes if value contains spaces.
CODEX_CLI_ARGS='exec --json --dangerously-bypass-approvals-and-sandbox'
CODEX_CLI_TIMEOUT_MS=1800000

# History follow
CODEX_HISTORY_ENABLED=true
CODEX_HISTORY_DIR=~/.codex/sessions
CODEX_HISTORY_SCAN_TTL_MS=5000
CODEX_HISTORY_ACTIVE_WINDOW_MS=1800000
CODEX_HISTORY_TAIL_INTERVAL_MS=2000
